# Owned by ansible/janus; do not flush the ruleset or firewalld/Tailscale tables.
# nft -f commits the table replacement as one transaction.
destroy table inet public_edge
table inet public_edge {
    chain input {
        type filter hook input priority -10; policy accept;
        iifname "wg-public-edge" counter drop
    }

    chain forward {
        type filter hook forward priority -10; policy accept;

        iifname "wg-public-edge" ct state invalid counter drop
        iifname "wg-public-edge" oifname "ens18" ip saddr 10.254.41.1 ip daddr 10.1.6.41 tcp dport { 8022, 8080, 8443 } ct state { new, established } counter accept
        iifname "wg-public-edge" counter drop

        oifname "wg-public-edge" ip daddr 10.254.41.1 ct state { established, related } ct original ip saddr 10.254.41.1 ct original ip daddr 10.1.6.41 ct original proto-dst { 8022, 8080, 8443 } counter accept
        oifname "wg-public-edge" counter drop
    }

    chain postrouting {
        type nat hook postrouting priority 90; policy accept;
        iifname "wg-public-edge" oifname "ens18" ip saddr 10.254.41.1 ip daddr 10.1.6.41 tcp dport { 8022, 8080, 8443 } snat ip to 10.1.1.41
    }
}
