{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Override Bambuddy source",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/maziggy/bambuddy"],
      allowedVersions: "/^\\d+\\.\\d+\\.\\d+(\\.\\d+)?$/",
      sourceUrl: "https://github.com/maziggy/bambuddy",
      versioning: "loose"
    }
  ]
}
