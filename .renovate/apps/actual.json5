{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Override Actual Budget changelog URL",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/actualbudget/actual"],
      changelogUrl: "https://actualbudget.org/blog/release-{{{replace '^v' '' newVersion}}}"
    }
  ]
}
