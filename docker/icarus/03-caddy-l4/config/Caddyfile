{
	email {$CADDY_ACME_EMAIL}
	http_port 8080
	https_port 8443

	layer4 {
		:443 {
      matching_timeout 15s
			@local tls sni {$VPS_LOCAL_HOSTS}
			route @local {
				proxy {
					proxy_protocol v2
					upstream 127.0.0.1:8443
				}
			}
			route {
				proxy {
					proxy_protocol v2
					upstream 10.1.6.41:8443
				}
			}
		}
		:80 {
			@local_http http host {$VPS_LOCAL_HOSTS}
			route @local_http {
				proxy {
					proxy_protocol v2
					upstream 127.0.0.1:8080
				}
			}
			route {
				proxy {
					proxy_protocol v2
					upstream 10.1.6.41:8080
				}
			}
		}
		:22 {
			route {
				proxy {
					proxy_protocol v2
					upstream 10.1.6.41:8022
				}
			}
		}
	}

	servers :8443 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
			tls
		}
	}
	servers :8080 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
		}
	}

	log default {
		output stdout
		format json
	}
}

icarus-doco-cd.bjw-s.dev {
	reverse_proxy doco-cd:8880
}

icarus-gatus.bjw-s.dev {
	reverse_proxy gatus:8080
}
