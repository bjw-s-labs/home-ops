{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "dedupe": true,
    "gc": true,
    "gcDelay": "24h",
    "gcTimeWindow": "01:00-08:00"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "externalUrl": "https://registry.bjw-s.dev",
    "auth": {
      "openid": {
        "providers": {
          "kanidm": {
            "issuer": "https://idm.bjw-s.dev/oauth2/openid/zot",
            "clientid": "${ZOT_OIDC_CLIENT_ID}",
            "clientsecret": "${ZOT_OIDC_CLIENT_SECRET}",
            "scopes": ["openid", "email", "profile", "groups"]
          }
        }
      },
      "bearer": {
        "realm": "https://registry.bjw-s.dev/zot/auth/token",
        "service": "registry.bjw-s.dev",
        "oidc": [
          {
            "issuer": "https://idm.bjw-s.dev/oauth2/openid/zot",
            "audiences": ["${ZOT_OIDC_CLIENT_ID}"]
          }
        ]
      }
    },
    "accessControl": {
      "repositories": {
        "**": {
          "anonymousPolicy": ["read"],
          "defaultPolicy": ["read", "create", "update"]
        }
      }
    }
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "search": {
      "enable": true
    },
    "ui": {
      "enable": true
    },
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://index.docker.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "15m",
          "maxRetryDelay": "15m",
          "content": [
            {
              "prefix": "/docker.io/**",
              "destination": "/",
              "stripPrefix": true
            }
          ]
        },
        {
          "urls": ["https://ghcr.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "15m",
          "maxRetryDelay": "15m",
          "content": [
            {
              "prefix": "/ghcr.io/**",
              "destination": "/",
              "stripPrefix": true
            }
          ]
        },
        {
          "urls": ["https://registry.k8s.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "15m",
          "maxRetryDelay": "15m",
          "content": [
            {
              "prefix": "/registry.k8s.io/**",
              "destination": "/",
              "stripPrefix": true
            }
          ]
        },
        {
          "urls": ["https://quay.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "15m",
          "maxRetryDelay": "15m",
          "content": [
            {
              "prefix": "/quay.io/**",
              "destination": "/",
              "stripPrefix": true
            }
          ]
        }
      ]
    }
  }
}