{
  "distSpecVersion": "1.1.0",
  "storage": {
    "gc": true,
    "rootDirectory": "/var/lib/registry"
  },
  "http": {
    "accessControl": {
      "repositories": {
        "**": {
          "anonymousPolicy": ["read"],
          "defaultPolicy": ["read"]
        },
        "bjw-s/**": {
          "policies": [
            {
              "users": ["zot-push"],
              "actions": ["read", "create", "update"]
            },
            {
              "groups": ["registry-ui-users"],
              "actions": ["read", "delete"]
            }
          ],
          "defaultPolicy": ["read"]
        },
        "docker-hub/**": {
          "anonymousPolicy": ["read"],
          "defaultPolicy": ["read"],
          "policies": [
            {
              "groups": ["registry-ui-users"],
              "actions": ["read", "delete"]
            }
          ]
        },
        "ghcr/**": {
          "anonymousPolicy": ["read"],
          "defaultPolicy": ["read"],
          "policies": [
            {
              "groups": ["registry-ui-users"],
              "actions": ["read", "delete"]
            }
          ]
        }
      }
    },
    "address": "0.0.0.0",
    "auth": {
      "apikey": true,
      "htpasswd": {
        "path": "/etc/zot/htpasswd"
      },
      "openid": {
        "callbackAllowOrigins": ["https://registry.bjw-s.dev"],
        "providers": {
          "oidc": {
            "name": "Kanidm",
            "issuer": "https://idm.bjw-s.dev/oauth2/openid/zot",
            "credentialsFile": "/etc/zot/openid-credentials.json",
            "scopes": ["openid", "profile", "email", "groups"],
            "claimMapping": {
              "username": "preferred_username",
              "groups": "zot_groups"
            }
          }
        }
      },
      "sessionKeysFile": "/etc/zot/sessionKeys.json"
    },
    "externalUrl": "https://registry.bjw-s.dev",
    "port": "5000"
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "search": {
      "enable": true
    },
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://index.docker.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "5m",
          "content": [
            {
              "prefix": "**",
              "destination": "/docker-hub"
            }
          ]
        },
        {
          "urls": ["https://ghcr.io"],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "5m",
          "content": [
            {
              "prefix": "**",
              "destination": "/ghcr"
            }
          ]
        }
      ]
    },
    "ui": {
      "enable": true
    }
  }
}
