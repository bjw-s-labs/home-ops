# Hermes managed scope (/etc/hermes/.env). Applied last with override=True, so these values
# win over the shell environment and the agent-writable /opt/data/.env. Non-secret values only:
# this file is world-readable inside the container.

# Dashboard authentication: Kanidm via native self-hosted OIDC (confidential client + PKCE).
# HERMES_DASHBOARD_OIDC_CLIENT_SECRET comes from the pod env (hermes-kanidm-oauth2-credentials);
# pinning it here would override that value.
HERMES_DASHBOARD_PUBLIC_URL=https://hermes.bjw-s.dev
HERMES_DASHBOARD_OIDC_ISSUER=https://idm.bjw-s.dev/oauth2/openid/hermes
HERMES_DASHBOARD_OIDC_CLIENT_ID=hermes
HERMES_DASHBOARD_OIDC_SCOPES=openid profile email

# Keep the other bundled auth providers unconfigured (see config.yaml next to this file for the config keys).
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
HERMES_DASHBOARD_OAUTH_CLIENT_ID=

# The gateway's API server (enabled by the image's generated API_SERVER_KEY) stays on loopback;
# the dashboard reaches it in-pod and neither the Service nor the network policy exposes it.
API_SERVER_HOST=127.0.0.1
